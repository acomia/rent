# Copy this file to .env and fill in real values. Never commit .env.
#
# Only EXPO_PUBLIC_* vars are exposed to the app bundle. Secrets
# (Supabase service-role key, PayMongo secret key, Resend/SMS keys)
# must NOT go here — they live in Supabase edge function secrets.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
